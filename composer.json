{
    "name": "element119/module-custom-admin-logo",
    "type": "magento2-module",
    "description": "A Magento 2 module that allows admins to set the logo for their admin panel and login screen.",
    "license": "MIT",
    "authors": [
        {
            "name": "Kiel Pykett",
            "email": "pykettk@gmail.com"
        }
    ],
    "require": {
        "magento/framework": "*",
        "magento/module-backend": "*",
        "magento/module-config": "^101.0",
        "magento/module-store": "*"
    },
    "autoload": {
        "psr-4": {
            "Element119\\CustomAdminLogo\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
